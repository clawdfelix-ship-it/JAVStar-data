import * as fs from 'fs';

// 讀取所有抓取嘅活動
const events6 = JSON.parse(fs.readFileSync('./scraped-events-search.json', 'utf8'));

// 強化版女優名提取
function extractActressName(eventName: string): string | null {
  // 移除常見噪音
  let cleaned = eventName
    .replace(/^[【\[]完売[】\]]/g, '')
    .replace(/^[【\[].*?[】\]]/g, '')  // 移除開頭嘅 【XXX】
    .replace(/^\d+\/\d+\([日月火水木金土]\)/g, '')  // 移除日期 6/1(月)
    .replace(/^\d+:\d+/g, '')  // 移除時間
    .replace(/^\d+時(\d+分)?[~～]/g, '')  // 移除時間 17時～
    .replace(/[～~＆&]\d+時/g, '')
    .trim();

  // 噪音詞列表 (絕對唔係女優名)
  const noiseWords = [
    'イベント', 'イベン', 'リリース', 'サイン', '撮影会', 'オフ会', 'お渡し会',
    'お話し会', 'チェキ', '握手会', '個人', '撮影', '記念', '発売', '完売',
    '秋葉原', '兵庫', '岡山', '大阪', '東京', '名古屋', '神戸', '京都',
    'ハイパー', 'アルティメッ', 'パラドックス', 'サマー', 'ウィンター',
    '新作', '引退', 'デビュー', '誕生日', '生誕祭', 'ライブ', 'トーク',
    '11時', '12時', '13時', '14時', '15時', '16時', '17時', '18時', '19時', '20時',
    '上映会', '試写会', '舞台挨拶', '物販', '即売会',
  ];

  // 多種 pattern 提取
  const patterns = [
    // Pattern 1: XXさん、XXちゃん (最常見)
    /([\u3040-\u309F\u30A0-\u30FF\u4E00-\u9FFF]{2,12})(?:さん|ちゃん|くん)/,
    // Pattern 2: ～XXイベント / ＠XX
    /[～~＠@]([\u3040-\u309F\u30A0-\u30FF\u4E00-\u9FFF]{2,12})(?:イベント|オフ会|撮影会|サイン|お渡し)/,
    // Pattern 3: 開頭直接係名 (例如「依本しおり『XXX』」)
    /^([\u3040-\u309F\u30A0-\u30FF\u4E00-\u9FFF]{2,12})『/,
    // Pattern 4: 開頭名 + 空格
    /^([\u3040-\u309F\u30A0-\u30FF\u4E00-\u9FFF]{2,12})[\s　]/,
    // Pattern 5: 名字之後跟動作詞
    /([\u3040-\u309F\u30A0-\u30FF\u4E00-\u9FFF]{2,12})(?:が|の|『)/,
  ];

  for (const p of patterns) {
    const m = cleaned.match(p);
    if (m) {
      const candidate = m[1].trim();
      // 檢查係咪噪音詞
      if (noiseWords.some(noise => candidate.includes(noise) || noise.includes(candidate))) {
        continue;
      }
      // 至少 2 個字符
      if (candidate.length >= 2 && candidate.length <= 12) {
        return candidate;
      }
    }
  }

  return null;
}

// 標準化日期
function normalizeDate(dateStr: string): string {
  const clean = dateStr.split('\n')[0].trim();
  const parts = clean.split('/');
  if (parts.length === 3) {
    const y = parts[0];
    const m = parts[1].padStart(2, '0');
    const d = parts[2].padStart(2, '0');
    return `${y}-${m}-${d}`;
  }
  return clean;
}

async function main() {
  console.log(`讀取到 ${events6.length} 個活動 (6月)\n`);

  // 從 API 獲取現有女優
  console.log('獲取女優列表...');
  const res = await fetch('https://jav-star-data.vercel.app/api/actresses?limit=5500');
  const data = await res.json();
  const actressMap = new Map(data.data.map((a: any) => [a.name_ja, a.id]));
  console.log(`現有 ${actressMap.size} 個女優\n`);

  // 統計提取結果
  const matchedEvents: any[] = [];
  const newActresses = new Map<string, string[]>();  // name → eventIds
  const failedEvents: string[] = [];

  for (const event of events6) {
    const actressName = extractActressName(event.event_name);
    
    if (!actressName) {
      failedEvents.push(event.event_name);
      continue;
    }

    // 精確或模糊匹配
    let actressId = actressMap.get(actressName);
    if (!actressId) {
      for (const [name, id] of actressMap.entries()) {
        if (name.includes(actressName) || actressName.includes(name)) {
          actressId = id;
          break;
        }
      }
    }

    if (actressId) {
      matchedEvents.push({
        id: event.id,
        actress_id: actressId,
        title: event.event_name,
        venue: event.location || '',
        prefecture: event.location || '',
        datetime: normalizeDate(event.event_date),
        event_type: 'イベント',
        url: event.url,
      });
    } else {
      // 新女優候選
      if (!newActresses.has(actressName)) {
        newActresses.set(actressName, []);
      }
      newActresses.get(actressName)!.push(event.id);
    }
  }

  console.log('=== 提取結果 ===');
  console.log(`✅ 匹配到現有女優: ${matchedEvents.length}`);
  console.log(`🆕 新女優候選: ${newActresses.size} (對應 ${[...newActresses.values()].flat().length} 個活動)`);
  console.log(`❌ 完全提取失敗: ${failedEvents.length}\n`);

  console.log('--- 新女優候選列表 ---');
  for (const [name, eventIds] of newActresses) {
    console.log(`  ${name} (${eventIds.length} 個活動)`);
  }

  console.log('\n--- 完全失敗活動 (需手動處理) ---');
  failedEvents.slice(0, 10).forEach(e => console.log(`  ${e}`));
  if (failedEvents.length > 10) console.log(`  ... 仲有 ${failedEvents.length - 10} 個`);

  // Step 2: 自動新增新女優
  if (newActresses.size > 0) {
    console.log(`\n=== 開始新增 ${newActresses.size} 個新女優 ===`);
    const newActressData = [...newActresses.entries()].map(([name], idx) => {
      // 用名字 hash 生成 ID
      const hash = Buffer.from(name).toString('base64').replace(/[+/=]/g, '').slice(0, 12);
      return {
        id: `auto_${hash}`,
        name_ja: name,
        name_cn: null,
        avatar_url: null,
        bio: null,
        height: null,
        bust: null,
        waist: null,
        hip: null,
        birthday: null,
        debut_date: null,
        cup: null,
        agency: null,
        hobby: null,
        debut_year: null,
        debut_work: null,
        blog: null,
        official_site: null,
        tags: null,
      };
    });

    try {
      const newActressRes = await fetch('https://jav-star-data.vercel.app/api/seed', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ actresses: newActressData })
      });
      const result = await newActressRes.json();
      console.log('新女優導入結果:', JSON.stringify(result, null, 2));

      // 獲取新女優 ID 並補充 matchedEvents
      for (const [name, eventIds] of newActresses) {
        const hash = Buffer.from(name).toString('base64').replace(/[+/=]/g, '').slice(0, 12);
        const newId = `auto_${hash}`;
        for (const evId of eventIds) {
          const ev = events6.find((e: any) => e.id === evId);
          if (ev) {
            matchedEvents.push({
              id: ev.id,
              actress_id: newId,
              title: ev.event_name,
              venue: ev.location || '',
              prefecture: ev.location || '',
              datetime: normalizeDate(ev.event_date),
              event_type: 'イベント',
              url: ev.url,
            });
          }
        }
      }
    } catch (e: any) {
      console.error('新增女優失敗:', e.message);
    }
  }

  // Step 3: 批量導入活動
  console.log(`\n=== 導入 ${matchedEvents.length} 個活動 ===`);
  try {
    const result = await fetch('https://jav-star-data.vercel.app/api/seed', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ events: matchedEvents })
    });
    const resultData = await result.json();
    console.log('活動導入結果:', JSON.stringify(resultData, null, 2));
  } catch (e: any) {
    console.error('導入失敗:', e.message);
  }
}

main().catch(console.error);
