import * as fs from 'fs';

const events6 = JSON.parse(fs.readFileSync('./scraped-events-search.json', 'utf8'));

function extractActressName(eventName: string): string | null {
  // 步驟 1: 移除大量噪音
  let cleaned = eventName
    .replace(/[【\[].*?[】\]]/g, ' ')  // 移除所有【XXX】
    .replace(/\d+\/\d+\([日月火水木金土]\)/g, ' ')
    .replace(/\d+月\d+日（?[日月火水木金土]）?/g, ' ')
    .replace(/\d+時(\d+分)?[~～]?/g, ' ')
    .replace(/[~～＆&]/g, ' ')
    .replace(/[♡★☆♪]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  // 噪音詞 (絕對唔係名)
  const noiseWords = new Set([
    'イベント', 'イベン', 'リリース', 'サイン', '撮影会', 'オフ会', 'お渡し会',
    'お話し会', 'チェキ', '握手会', '個人', '撮影', '記念', '発売', '完売',
    '秋葉原', '兵庫県', '岡山県', '大阪府', '東京', '名古屋', '神戸', '京都',
    '新作', '引退', 'デビュー', '誕生日', '生誕祭', 'ライブ', 'トーク',
    '上映会', '試写会', '舞台挨拶', '物販', '即売会', '専属', '直販',
    '過激', '娘', '在', 'in', 'IN', 'AT', 'at', '＠', '@',
    '土曜', '日曜', '金曜', '月曜', '火曜', '水曜', '木曜',
    'AV女優', '女優', '販売', 'お渡し', 'パラダイス', 'ハイパー',
    'ラムタラ', 'エピカリアキバ', 'ムーラン', 'グローリー',
    '昭和通り口', '昭和', '通り', '口',
    '開催', '決定', '販売中', 'コラボ', '応援',
    'Chronicle', 'Online', 'Special',
  ]);

  // 多種 pattern (順序很重要，先嚴格後寬鬆)
  const patterns: { name: string; regex: RegExp }[] = [
    // P1: XXさん/ちゃん (最可靠)
    { name: 'san_chan', regex: /([\u30A0-\u30FF\u4E00-\u9FFF\u3040-\u309F]{2,10})(?:さん|ちゃん|くん)/g },
    // P2: 「XX」/『XX』
    { name: 'quote', regex: /[「『]([\u30A0-\u30FF\u4E00-\u9FFF\u3040-\u309F]{2,10})[」』]/g },
    // P3: 「♡XX♡」、「♡XX」
    { name: 'heart', regex: /♡([\u30A0-\u30FF\u4E00-\u9FFF\u3040-\u309F]{2,10})/g },
    // P4: 「XXイベント」之前
    { name: 'before_event', regex: /([\u30A0-\u30FF\u4E00-\u9FFF\u3040-\u309F]{2,10})(?:イベント|オフ会|撮影会|サイン会|お渡し会|握手会)/g },
    // P5: 空格分隔 (廠商標籤後嘅名字)
    { name: 'spaced', regex: /\s([\u30A0-\u30FF\u4E00-\u9FFF\u3040-\u309F]{2,10})\s/g },
  ];

  for (const { name, regex } of patterns) {
    const matches = [...cleaned.matchAll(regex)];
    for (const m of matches) {
      const candidate = m[1].trim();
      // 過濾噪音
      if (noiseWords.has(candidate)) continue;
      let isNoise = false;
      for (const noise of noiseWords) {
        if (candidate === noise || candidate.includes(noise) && candidate.length - noise.length <= 1) {
          isNoise = true;
          break;
        }
      }
      if (isNoise) continue;
      
      // 長度檢查
      if (candidate.length < 2 || candidate.length > 12) continue;
      
      // 純假名（沒有漢字 + 沒有片假名）通常唔係女優名
      const hasKana = /[\u3040-\u309F\u30A0-\u30FF]/.test(candidate);
      const hasKanji = /[\u4E00-\u9FFF]/.test(candidate);
      if (!hasKana && !hasKanji) continue;
      
      return candidate;
    }
  }

  return null;
}

function normalizeDate(dateStr: string): string {
  const clean = dateStr.split('\n')[0].trim();
  const parts = clean.split('/');
  if (parts.length === 3) {
    const y = parts[0];
    const m = parts[1].padStart(2, '0');
    const d = parts[2].padStart(2, '0');
    return `${y}-${m}-${d}`;
  }
  return clean;
}

async function main() {
  console.log(`讀取 ${events6.length} 個活動\n`);

  const res = await fetch('https://jav-star-data.vercel.app/api/actresses?limit=5500');
  const data = await res.json();
  const actressMap = new Map(data.data.map((a: any) => [a.name_ja, a.id]));
  console.log(`現有 ${actressMap.size} 個女優\n`);

  // 已導入活動 ID (避免重複)
  const importedRes = await fetch('https://jav-star-data.vercel.app/api/seed');
  const stats = await importedRes.json();
  console.log(`數據庫現有活動: ${stats.events}\n`);

  const matchedEvents: any[] = [];
  const newActresses = new Map<string, string[]>();
  const failedEvents: any[] = [];

  for (const event of events6) {
    const actressName = extractActressName(event.event_name);
    
    if (!actressName) {
      failedEvents.push(event);
      continue;
    }

    let actressId = actressMap.get(actressName);
    if (!actressId) {
      for (const [name, id] of actressMap.entries()) {
        if (name.includes(actressName) || actressName.includes(name)) {
          actressId = id;
          break;
        }
      }
    }

    if (actressId) {
      matchedEvents.push({
        id: event.id,
        actress_id: actressId,
        title: event.event_name,
        venue: event.location || '',
        prefecture: event.location || '',
        datetime: normalizeDate(event.event_date),
        event_type: 'イベント',
        url: event.url,
      });
    } else {
      if (!newActresses.has(actressName)) {
        newActresses.set(actressName, []);
      }
      newActresses.get(actressName)!.push(event.id);
    }
  }

  console.log('=== V3 提取結果 ===');
  console.log(`✅ 匹配現有女優: ${matchedEvents.length}`);
  console.log(`🆕 新女優候選: ${newActresses.size}`);
  console.log(`❌ 失敗: ${failedEvents.length}\n`);

  console.log('--- 新女優 ---');
  for (const [name, ids] of newActresses) {
    console.log(`  ${name} (${ids.length})`);
  }

  console.log('\n--- 失敗活動 (前 15) ---');
  failedEvents.slice(0, 15).forEach(e => console.log(`  ${e.event_name}`));

  // 新增新女優
  if (newActresses.size > 0) {
    const newActressData = [...newActresses.entries()].map(([name]) => ({
      id: `auto_${Buffer.from(name).toString('base64').replace(/[+/=]/g, '').slice(0, 12)}`,
      name_ja: name,
    }));

    const r = await fetch('https://jav-star-data.vercel.app/api/seed', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ actresses: newActressData })
    });
    console.log('\n新女優結果:', JSON.stringify(await r.json(), null, 2));

    for (const [name, eventIds] of newActresses) {
      const newId = `auto_${Buffer.from(name).toString('base64').replace(/[+/=]/g, '').slice(0, 12)}`;
      for (const evId of eventIds) {
        const ev = events6.find((e: any) => e.id === evId);
        if (ev) {
          matchedEvents.push({
            id: ev.id,
            actress_id: newId,
            title: ev.event_name,
            venue: ev.location || '',
            prefecture: ev.location || '',
            datetime: normalizeDate(ev.event_date),
            event_type: 'イベント',
            url: ev.url,
          });
        }
      }
    }
  }

  console.log(`\n=== 導入 ${matchedEvents.length} 個活動 ===`);
  const r2 = await fetch('https://jav-star-data.vercel.app/api/seed', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ events: matchedEvents })
  });
  console.log('活動結果:', JSON.stringify(await r2.json(), null, 2));
}

main().catch(console.error);
