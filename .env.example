# ── Database ──────────────────────────────────────────────
# Neon Postgres connection string (pooled). Copy from Neon console.
# NEVER commit the real value — this file is a template only.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# ── Admin / cron auth ─────────────────────────────────────
# Shared secret required to call /api/admin/*, /api/setup, /api/seed, /api/debug-*
# Send as header:  x-admin-token: <value>
ADMIN_TOKEN=change-me-to-a-long-random-string

# Secret for Vercel Cron calls to /api/cron/*
# Vercel sends:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-to-another-long-random-string
